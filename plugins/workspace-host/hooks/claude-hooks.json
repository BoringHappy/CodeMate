{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "bash \"${CODEMATE_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/dispatch.sh\" record_session_status.sh", "timeout": 10}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "bash \"${CODEMATE_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/dispatch.sh\" record_session_status.sh", "timeout": 10}]}],
    "Stop": [{"hooks": [
      {"type": "command", "command": "bash \"${CODEMATE_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/dispatch.sh\" record_session_status.sh", "timeout": 10},
      {"type": "command", "command": "bash \"${CODEMATE_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/dispatch.sh\" claude_stop.sh", "asyncRewake": true, "timeout": 604800, "statusMessage": "Monitoring pull request feedback"}
    ]}]
  }
}
