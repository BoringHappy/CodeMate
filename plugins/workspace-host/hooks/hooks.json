    "Stop": [{"hooks": [{"type": "command", "command": "bash \"${CODEMATE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/hooks/dispatch.sh\" stop.sh", "timeout": 604800, "statusMessage": "Checking pull request feedback"}]}]
  }
