{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "bash \"${CODEMATE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/hooks/dispatch.sh\" record_session_status.sh", "timeout": 10}]}],
