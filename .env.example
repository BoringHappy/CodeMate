# CodeMate Environment Configuration

# Optional: Default repository URL
# GIT_REPO_URL=

# Required: Comma-separated list of ip-api.com 'countryCode' values the
# container is allowed to run in. The container queries http://ip-api.com/json/
# before starting Claude; on mismatch it files a GitHub issue and exits.
# Example: CODEMATE_ALLOW_COUNTRY=US,CA,GB
CODEMATE_ALLOW_COUNTRY=

# Anthropic API Configuration
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=

# Custom Plugin Configuration
# Add your own plugin marketplaces (comma-separated GitHub repo paths)
# Example: CUSTOM_MARKETPLACES=username/my-marketplace,org/another-marketplace
# CUSTOM_MARKETPLACES=

# Add your own plugins to install (comma-separated plugin names)
# Example: CUSTOM_PLUGINS=my-plugin@my-marketplace,another-plugin@my-marketplace
# CUSTOM_PLUGINS=
