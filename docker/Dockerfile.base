# Base image for CodeMate - Ubuntu 25.10 (Questing)
# This image contains system packages, development tools, and dependencies
# Built weekly to keep packages up-to-date
ARG BASE_IMAGE=ubuntu:questing
FROM ${BASE_IMAGE}

# Environment variables
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH=/home/agent/.local/bin:/usr/local/share/npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Create non-root user and configure system
RUN set -ex \
    && userdel ubuntu || true \
    && useradd --create-home --uid 1000 --shell /bin/bash agent \
    && usermod -aG sudo agent \
    && mkdir -p /etc/sudoers.d \
    && chmod 0755 /etc/sudoers.d \
    && echo "agent ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/agent \
    && echo "Defaults:%sudo env_keep += \"http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY SSL_CERT_FILE NODE_EXTRA_CA_CERTS REQUESTS_CA_BUNDLE\"" > /etc/sudoers.d/proxyconfig \
    && chown -R agent:agent /home/agent \
    && mkdir -p /usr/local/share/npm-global \
    && chown -R agent:agent /usr/local/share/npm-global

# Install CLI tools, development packages, and Node.js LTS
# Optimize apt: disable unused repositories (multiverse, backports)
RUN sed -i '/^Types:/,/^$/{ /Components:/s/ multiverse//g; }' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true \
    && rm -f /etc/apt/sources.list.d/*backports*

RUN set -euxo pipefail \
    && apt-get update \
    && apt-get install -yy --no-install-recommends ca-certificates curl gnupg locales \
    && locale-gen C.UTF-8 \
    && update-locale LANG=C.UTF-8 \
    && curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get install -yy --no-install-recommends --fix-missing \
        bc \
        build-essential \
        cmake \
        cron \
        dnsutils \
        gh \
        git \
        golang \
        jq \
        less \
        libclang-dev \
        libssl-dev \
        lsof \
        make \
        man-db \
        nodejs \
        pkg-config \
        pre-commit \
        procps \
        psmisc \
        python3 \
        python3-pip \
        ripgrep \
        rsync \
        socat \
        sudo \
        tmux \
        tree \
        unzip \
        vim \
        zsh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && chsh -s $(which zsh) agent \
    && npm cache clean --force

# Install kubectl and helm (multi-arch: amd64/arm64) - latest stable versions
RUN set -euxo pipefail \
    && ARCH=$(dpkg --print-architecture) \
    && KUBECTL_VERSION=$(curl -fsSL https://dl.k8s.io/release/stable.txt) \
    && curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl" \
    && chmod +x /usr/local/bin/kubectl \
    && curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

# Install AWS CLI v2 (multi-arch: amd64/arm64)
RUN set -euxo pipefail \
    && ARCH=$(dpkg --print-architecture) \
    && case "${ARCH}" in \
         amd64) AWS_ARCH=x86_64 ;; \
         arm64) AWS_ARCH=aarch64 ;; \
         *) echo "Unsupported architecture: ${ARCH}" && exit 1 ;; \
       esac \
    && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWS_ARCH}.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscliv2.zip /tmp/aws

# Switch to agent user for user-specific installations
USER agent

# Install Oh My Zsh
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended \
    && sed -i 's/ZSH_THEME="robbyrussell"/ZSH_THEME="ys"/g' /home/agent/.zshrc

# Install Rust, cargo, rust-script, uv, and pixi
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && echo 'source $HOME/.cargo/env' >> /home/agent/.zshrc \
    && . $HOME/.cargo/env \
    && cargo install rust-script \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && echo 'eval "$(uv generate-shell-completion zsh)"' >> /home/agent/.zshrc \
    && curl -fsSL https://pixi.sh/install.sh | sh \
    && echo 'eval "$(pixi completion --shell zsh)"' >> /home/agent/.zshrc

# Add pixi bin directory to PATH so pixi-managed binaries are available
ENV PATH=/home/agent/.pixi/bin:${PATH}
