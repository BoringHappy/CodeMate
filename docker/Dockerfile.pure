# CodeMate Pure - Claude Code and Codex in a plain zsh container
#
# Unlike docker/Dockerfile, this image performs no repository setup: there is
# no setup entrypoint, no plugin marketplace, and no agent launcher. The
# container starts an interactive zsh session and CodeMate mounts the host
# ~/.codemate directory so existing Claude/Codex credentials and configs are
# reused.
ARG BASE_IMAGE=ghcr.io/boringhappy/codemate-base:latest
FROM ${BASE_IMAGE}

# The base image already provides the non-root agent user, zsh, and the dev
# toolchain; only the coding agents are installed here.
USER root

# npm installs run as the agent user below, so make sure the shared npm prefix
# is writable by it. Base images built before the ownership fix in
# Dockerfile.base still ship lib/node_modules owned by root.
RUN chown -R agent:agent /usr/local/share/npm-global

USER agent
# Prefer npm-managed tools over any persisted standalone symlink in ~/.local/bin.
ENV PATH="/usr/local/share/npm-global/bin:/home/agent/.local/bin:${PATH}"
# Keep Claude Code from spending startup traffic on telemetry, auto-updates,
# and other non-essential network calls inside the container.
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
RUN curl -fsSL https://claude.ai/install.sh | bash \
    && npm install -g @openai/codex@latest \
    && claude --version \
    && codex --version

# CodeMate launches its own agents with permission checks disabled, so give
# pure users the same behavior by aliasing both CLIs to their "allow
# everything" flags.
RUN cat >> /home/agent/.zshrc <<'EOF'

# CodeMate: run the agents with permission prompts disabled.
alias claude='claude --dangerously-skip-permissions'
alias codex='codex --yolo'
EOF

CMD ["zsh"]
